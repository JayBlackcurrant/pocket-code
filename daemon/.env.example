# PocketCode daemon configuration (copy to .env; never commit the real .env).

# Interface to bind. MUST be 127.0.0.1 or the Mac's Tailscale IP — never 0.0.0.0.
RELAYD_HOST=127.0.0.1
RELAYD_PORT=8787

# Directory holding per-project manifests (config/projects/*.yaml).
RELAYD_PROJECTS_DIR=./config/projects

# SQLite event-log database path (created if missing; gitignored).
RELAYD_DB_PATH=./data/relayd.sqlite

# Root under which task worktrees are created on the agent user.
RELAYD_WORKSPACES_DIR=

# Comma-separated absolute directories a registered repo path must resolve inside.
# Any project/file/worktree path outside these (or using ../ or a symlink escape) is
# rejected. Example for the dev machine:
# RELAYD_ALLOWED_ROOTS=/Users/you/Downloads/Projects

# Expanded into manifest paths like ${AGENT_HOME}/workspaces/<repo>.
# AGENT_HOME=/Users/agent

# Command-execution sandbox for agent tasks (filesystem + network allowlist). On by
# default (CLAUDE.md). Set to "off" only if a build fails under the sandbox while you
# investigate. Dangerous commands are blocked by permission rules regardless.
# RELAYD_SANDBOX=on

# Auto-deny a pending phone approval after this many minutes so runs never hang (S2-03).
# The agent is told to stop and summarize. Default 120. Set 0 to wait indefinitely.
# RELAYD_APPROVAL_TIMEOUT_MINUTES=120

# Wrap long build/upload jobs in `caffeinate -i` so the Mac doesn't idle-sleep mid-build
# (S3-08). macOS only (no-op elsewhere). On by default; set "off" to disable.
# RELAYD_CAFFEINATE=on

# URL the phone should connect to (used in the pairing QR; NOT the bind address).
# For a phone over Tailscale, set this to the Mac's MagicDNS URL. Defaults to
# http://<RELAYD_HOST>:<RELAYD_PORT>.
# RELAYD_ADVERTISE_URL=http://my-mac.tailXXXX.ts.net:8787

# Claude credentials for the Agent SDK. Pick ONE; never hand-copy tokens out of ~/.claude.
#   1) API key / Team API credits:          ANTHROPIC_API_KEY=
#   2) Subscription (logged-in Claude Code): leave both unset and just run `claude`
#      logged in on this Mac — the SDK uses that session. If headless auth doesn't pick
#      it up, run `claude setup-token` and set CLAUDE_CODE_OAUTH_TOKEN below.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
